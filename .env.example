# Copy to .env.local and fill in. Placeholders only: never commit real values.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# Required. Google AI Studio key.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Required. Local VoiceStudio (or `npm run mock:voicestudio`). Must be https unless loopback.
VOICESTUDIO_BASE_URL=http://127.0.0.1:3900

# Required. Built-in voice for testing; use your cloned profile id (8 chars) or unique name for the real voice.
VOICESTUDIO_VOICE_ID=alloy

# Required when VOICESTUDIO_BASE_URL is not loopback (hosted). Leave empty locally.
# Generate: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
VOICESTUDIO_AUTH_TOKEN=

# Optional private profile as one-line JSON. Locally, profile/profile.private.json is simpler.
# JEFFY_PROFILE_JSON=

# Optional tuning (defaults shown).
# VOICESTUDIO_MODEL=
# VOICESTUDIO_RESPONSE_FORMAT=wav
# VOICESTUDIO_TIMEOUT_MS=40000
# GEMINI_TIMEOUT_MS=15000
