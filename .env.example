# Copy to .env.local and fill in. Placeholders only: never commit real values.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# Required. Google AI Studio key.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# --- Voice (optional: only needed when voice or Talk mode is used) ---
# Voice provider: gradium (default when GRADIUM_API_KEY is set) or voicestudio.
VOICE_PROVIDER=gradium

# Gradium (hosted). Free key: https://gradium.ai
GRADIUM_API_KEY=your-gradium-api-key
# Cloned voice uid (npm run clone:gradium) or a built-in uid (npm run voices:gradium).
GRADIUM_VOICE_ID=your-voice-uid

# --- Optional: self-hosted VoiceStudio (set VOICE_PROVIDER=voicestudio) ---
# Local VoiceStudio (or `npm run mock:voicestudio`). Must be https unless loopback.
# VOICESTUDIO_BASE_URL=http://127.0.0.1:3900

# Required. Built-in voice for testing; use your cloned profile id (8 chars) or unique name for the real voice.
# VOICESTUDIO_VOICE_ID=alloy

# Required when VOICESTUDIO_BASE_URL is not loopback (hosted). Leave empty locally.
# Generate: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# VOICESTUDIO_AUTH_TOKEN=

# Optional IANA timezone for today's date in the prompt (default America/Denver).
# JEFFY_TIMEZONE=America/Denver

# Optional tuning (defaults shown).
# VOICESTUDIO_MODEL=
# VOICESTUDIO_RESPONSE_FORMAT=wav
# VOICE_TIMEOUT_MS=40000   (VOICESTUDIO_TIMEOUT_MS still works as a fallback)
# GEMINI_TIMEOUT_MS=50000
